# Copy this file to .env and adjust as needed. Nothing here is required to
# run ProfitPilot with its default (rule_based / tfidf) backends.

# --- Reasoning Engine ---
# rule_based | anthropic | huggingface_local
REASONING_ENGINE_BACKEND=rule_based
REASONING_ENGINE_MODEL=deepanalyze-8b
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
REASONING_MAX_TOKENS=1200
REASONING_TEMPERATURE=0.2

# --- Vector Store / RAG ---
# tfidf | chromadb
VECTOR_STORE_BACKEND=tfidf
RAG_TOP_K=4

# --- Analysis ---
ANOMALY_CONTAMINATION=0.08
FORECAST_PERIODS=6
LOW_MARGIN_THRESHOLD_PCT=10.0
SLOW_MOVING_STOCK_DAYS=60

# --- General ---
LOG_LEVEL=INFO
VERBOSE_TERMINAL=true

KAGGLE_USERNAME=your_username
KAGGLE_KEY=api_token
